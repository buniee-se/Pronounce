# Supabase Project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase Publishable / Anon Public Key (Settings -> API -> Project API keys -> anon public)
# Safe for browser use when Row Level Security (RLS) is enabled on all tables.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
